# ---- 金鑰與環境變數：絕對不上傳 ----
.env
.env.*
!.env.example
*.key
*.pem
*secret*
*token*
credentials*.json

# ---- 原始資料與中間檔：不上傳，只上傳網頁讀取的 data/web/ ----
data/raw/
data/interim/
data/unused/
cache/
*.ods
*.xlsx
*.pbf

# ---- 本機環境、個人檔案、舊版作品 ----
.venv/
__pycache__/
.claude/
Claude outputs/
archive/
.DS_Store

# ---- 本機工具（GitHub CLI 等） ----
tools/

# ---- 舊版輸出、軌跡樣本（含 trace_id，不公開）、使用者自己的 Netlify 副本 ----
data/interim_sample/
data/processed/
netlify上傳用/
